# YouTube Data API v3 key (one Google Cloud project). YOUTUBE_API_KEY_1 is also accepted.
YOUTUBE_API_KEY=

# Playlist publisher (SmartTube experiment): a Desktop OAuth client in the same Google Cloud project.
# `pnpm youtube-login` stores the refresh token in data/secrets/youtube-token.json (gitignored).
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
